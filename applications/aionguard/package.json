{
  "name": "aionguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node --import tsx src/server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "compare": "node --import tsx scripts/compare.ts",
    "format": "prettier --write src tests scripts *.json *.ts index.html",
    "format:check": "prettier --check src tests scripts *.json *.ts index.html",
    "start:protected": "node --import tsx scripts/start-protected.ts",
    "accept:live": "node --import tsx scripts/accept-live.ts --live",
    "qualify:solari": "node --import tsx scripts/qualify-solari.ts --live",
    "qualify:detectors": "node --import tsx scripts/qualify-detector-fixtures.ts --live",
    "benchmark:solari": "node --import tsx scripts/benchmark-solari.ts",
    "benchmark:corpus": "node --import tsx scripts/benchmark-corpus.ts",
    "qualify:warm": "node --import tsx scripts/qualify-warm-solari.ts",
    "benchmark:astra": "node --import tsx scripts/benchmark-astra-review.ts",
    "qualify:click": "node --import tsx scripts/qualify-controlled-click.ts"
  },
  "dependencies": {
    "@solarisdk/sandbox": "0.1.2",
    "@vercel/sandbox": "3.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.58.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "contributors": [
    {
      "name": "Blake Grove"
    },
    {
      "name": "Megan Frey"
    }
  ]
}
