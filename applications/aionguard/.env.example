# The long-lived controller binds only to loopback. Node 24 LTS is recommended.
AIONGUARD_PORT=4317
# LIVE is the default and fails closed until explicitly configured.
AIONGUARD_MODE=LIVE
AIONGUARD_PROVIDER=SOLARI
AIONGUARD_WORKFLOW=DETECTOR
# Prepare one Solari sandbox ahead of inspection; retain only after no rule findings.
# Use FRESH to provision and retire a sandbox for every inspection.
AIONGUARD_SOLARI_SESSION=WARM
# Optional absolute path to an existing private Solari env file; never commit it.
AIONGUARD_SOLARI_ENV_PATH=
SOLARI_API_KEY=
AIONGUARD_SOLARI_SETUP_TIMEOUT_MS=210000
# Optional official Vercel CLI env export; keep credentials outside this example.
AIONGUARD_VERCEL_ENV_PATH=
# Generate locally, keep private; minimum 32 characters. Never VITE_-prefix secrets.
AIONGUARD_CONTROLLER_TOKEN=
# Separate token permitting only an authorized registered-link handoff.
AIONGUARD_ENTRY_TOKEN=
AIONGUARD_EXTENSION_ORIGINS=
# Optional display-only report; all source runs remain in comparisons/.
AIONGUARD_COMPARISON_PATH=runtime-data/comparison-latest.json
ASTRA_CLI_PATH=/Applications/Codex.app/Contents/Resources/codex
OPENAI_MODEL=gpt-6-astra
ASTRA_TIMEOUT_MS=60000
# Explicit official Vercel credentials; never sent to the guest or browser.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
AIONGUARD_VERCEL_SNAPSHOT_ID=
AIONGUARD_SNAPSHOT_APPROVAL_PATH=runtime-data/snapshot-approval.json
AIONGUARD_VERCEL_REGION=iad1
# Exact administrator-owned URL; request bodies cannot supply destinations.
AIONGUARD_FIXTURE_URL=
# Legacy dedicated origin resolves to /acme-login.html. If both are set, origins must match.
AIONGUARD_FIXTURE_ORIGIN=
AIONGUARD_IDP_ORIGINS=
AIONGUARD_SANDBOX_TIMEOUT_MS=45000
AIONGUARD_MAX_CONCURRENT_SANDBOXES=1
